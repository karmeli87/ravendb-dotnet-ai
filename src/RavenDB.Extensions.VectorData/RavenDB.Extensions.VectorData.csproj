<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RavenDB.Extensions.VectorData</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RavenDB.Extensions.VectorData</PackageId>
    <Description>RavenDB vector store for Microsoft.Extensions.VectorData: typed and dynamic collections, vector search with RavenDB-side embeddings, for Microsoft Agent Framework, Semantic Kernel or any MEVD consumer.</Description>
    <Authors>RavenDB</Authors>
    <PackageTags>ravendb;vector;vectordata;semantic-kernel;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RavenDB.Extensions.VectorData.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.11.0" />
    <PackageReference Include="RavenDB.Client" Version="7.2.6" />
  </ItemGroup>

</Project>
